<?xml version="1.0"?>
<robot name="turret" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="mass" value="1.0" />
    <!-- Add Mesh Link -->
  <link name="turret_link">
    <visual>
      <material name="clearpath_black"/>
      <geometry>
        <mesh filename="package://doody_description/meshes/turret/turret.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.385 0.206 0.419" />
      </geometry>
    </collision>
  </link>

  <link name="realsense_mount_link">
    <visual>
      <material name="clearpath_black"/>
      <geometry>
          <mesh filename="package://doody_description/meshes/realsense_mount/realsense_mount.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.00965 -0.003639 -0.007" rpy="0 0 0"/>
      <geometry>
          <box size="0.0193 0.0683 0.042"/>
      </geometry>
    </collision>
  </link>

  <link name="d435_mount_link" />
  <link name="t265_mount_link" />
  <link name="gen3_mount_link" />


  <!-- Add Mesh Joint -->
  <joint name="mount_to_d435_joint" type="fixed">
      <parent link="realsense_mount_link" />
      <child link="d435_mount_link" />
      <origin xyz="0.006 0.000997 -0.01" rpy="0 0 0"/>
  </joint>

  <joint name="mount_to_t265_joint" type="fixed">
      <parent link="realsense_mount_link" />
      <child link="t265_mount_link" />
      <origin xyz="0.0193 -0.007104 -0.02175" rpy="0 0 0"/>
  </joint>

  <joint name="turret_to_cameras_joint" type="fixed">
      <parent link="turret_link"></parent>
      <child link="realsense_mount_link"></child>
      <origin xyz="0.1659 0 0.3828" rpy="0 0 0" />
  </joint>

  <joint name="turret_to_gen3_joint" type="fixed">
      <parent link="turret_link"></parent>
      <child link="gen3_mount_link"></child>
      <origin xyz="0.0125 0 0.3984" rpy="0 0 0" />
  </joint>

  <joint name="turret_to_base" type="fixed">
    <child link="turret_link"/>
    <parent link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- t265  frame definition can be found at https://github.com/IntelRealSense/librealsense/blob/master/doc/t265.md -->
  <!-- odom_xyz and odom_rpy paramenters are used as a base for odometry, they represent the trasformation from the robot
       base_link. unite_imu_method can be "false", "copy" or "linear_interpolation" -->
  <xacro:include filename="$(find doody_description)/urdf/_t265.urdf.xacro"/>
  <xacro:sensor_t265  parent="t265_mount_link" name="t265" topics_ns="mobile_manip"
                      odom_xyz="0.0 0.0 0.25" odom_rpy="0.0 0.0 0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:sensor_t265>
</robot>